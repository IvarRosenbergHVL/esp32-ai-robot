# Copy this file to .env for local development. Never commit .env or real keys.
#
# AZURE RESOURCES YOU MUST CREATE/DEPLOY
# 1. Create one "Speech service" (Azure AI Speech) resource.
#    Copy its region and one API key into AZURE_SPEECH_REGION/KEY below.
#    The same resource is used for Norwegian STT and TTS.
# 2. Create an Azure OpenAI / Azure AI Foundry resource with access to a GPT model.
#    Deploy a model that supports the Responses API and structured JSON output.
#    Copy the deployment name, resource endpoint and API key below.
# 3. Deploy this backend (for example as Azure Container Apps or App Service).
#    Do NOT deploy these secrets to the ESP32. Configure them only as backend
#    environment variables / secret references in Azure.
#
# Start with all providers set to "mock" to test the HTTP contract without Azure.

PORT=3000
MAX_AUDIO_BYTES=4000000
REQUEST_TIMEOUT_MS=30000

# Optional shared secret between the ESP32 and backend for the MVP.
# When set, requests must include: Authorization: Bearer <ROBOT_API_KEY>
ROBOT_API_KEY=

# Provider switches: mock | azure
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# Azure AI Speech: create a Speech service resource.
AZURE_SPEECH_REGION=norwayeast
AZURE_SPEECH_KEY=
AZURE_SPEECH_LANGUAGE=nb-NO
AZURE_SPEECH_VOICE=nb-NO-FinnNeural

# Complete Azure OpenAI resource endpoint, without a trailing slash.
# Example: https://my-robot-openai.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# This is the DEPLOYMENT NAME you chose in Azure, not merely the model family.
AZURE_OPENAI_DEPLOYMENT=

# Keep the API version configurable because Azure preview/stable versions change.
# Use the version shown for the Responses API in your Azure resource documentation.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Used only by mock mode. MOCK_TTS_FILE can point to a small local MP3 file.
MOCK_TRANSCRIPT=Hei, hvem er du?
MOCK_TTS_FILE=
